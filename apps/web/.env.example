# ─────────────────────────────────────────────────────────
# yo-skill web — 环境变量样例
# 复制为 .env.local 并按需填写。
# Phase 1 官网落地页 + 等待列表：无需任何变量即可运行。
# ─────────────────────────────────────────────────────────

# Phase 2 — Skill 市场数据层（Postgres + Prisma）
# DATABASE_URL=

# Phase 3 — 会员认证（Auth.js / NextAuth）
# AUTH_SECRET=

# Phase 3 — Stripe 订阅
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
